{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://withmarble.com/taxonomy/schema/i18n-topics.schema.json",
  "title": "Marble Skill Taxonomy — topic translations",
  "type": "object",
  "required": ["locale", "version", "source", "attribution", "topicCount", "topics"],
  "properties": {
    "locale": { "type": "string", "const": "es-419" },
    "version": { "type": "string" },
    "source": { "type": "string", "const": "topics.json" },
    "attribution": { "type": "string", "minLength": 1 },
    "topicCount": { "type": "integer", "minimum": 0 },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^mt_" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
